(* The part of SQL that pine.sql.transpile can turn into Pine: one SELECT,
   UPDATE or DELETE, with WITH queries, joins, WHERE, GROUP BY, ORDER BY and
   LIMIT. See docs/sql-to-pine.md.

   This reads one statement. pine.sql.parser splits a script on `;` first,
   and drops BEGIN, COMMIT and ROLLBACK itself.

   Keywords are case-insensitive regexes ending in \b, so `selected` is never
   `select` followed by `ed`. Every keyword is excluded from bare
   identifiers, including ones this grammar never uses (OFFSET, DISTINCT,
   HAVING, ...): otherwise `FROM t OFFSET 5` would read OFFSET as t's alias,
   and the error would land on `5` instead of on the word Pine can't say.
   pine.sql.parser names that word in its error.

   Nothing here decides whether Pine can express a query. A few things are
   read only so the transpiler can refuse them by name, with their line:
   `= NULL`, a comparison with no column, ORDER BY a position, a cast Pine
   doesn't have. *)

statement     := <ws?> with? (select | update | delete) <ws?> (<";"> <ws?>)?

(* WITH a AS (...), b AS (...): each becomes a Pine block ending in |= a. *)
with          := <WITH> <ws> cte (<ws?> <","> <ws?> cte)* <ws?>
cte           := identifier <ws> <AS> <ws?> <"("> <ws?> select <ws?> <")">

select        := <SELECT> <ws> (distinct-on | distinct)? select-list <ws> from join* where? group? having? order? limit?
distinct      := <DISTINCT> <ws>
distinct-on   := <DISTINCT> <ws?> <ON> <ws?> <"("> <ws?> column (<ws?> <","> <ws?> column)* <ws?> <")"> <ws?>

select-list   := select-item (<ws?> <","> <ws?> select-item)*
select-item   := star | alias-star | count-star as-alias? | row-number as-alias? | column as-alias? | computed as-alias?
star          := <"*">
alias-star    := identifier <ws?> <"."> <ws?> <"*">
count-star    := <COUNT> <ws?> <"("> <ws?> (<"*"> | <"1">) <ws?> <")"> filter?
(* ROW_NUMBER() OVER (PARTITION BY ... ORDER BY ...): Pine's limit: N per,
   when a later query keeps rows with rn = 1 or rn <= N. *)
row-number    := <ROW_NUMBER> <ws?> <"("> <ws?> <")"> <ws?> <OVER> <ws?> <"("> <ws?> partition? window-order? <")">
partition     := <PARTITION> <ws> <BY> <ws> (column | computed) (<ws?> <","> <ws?> (column | computed))* <ws?>
window-order  := <ORDER> <ws> <BY> <ws> order-item (<ws?> <","> <ws?> order-item)* <ws?>
<as-alias>    := <ws> (<AS> <ws>)? alias
alias         := identifier

from          := <FROM> <ws> (table-ref | derived)
table-ref     := table-name as-alias?
table-name    := identifier (<ws?> <"."> <ws?> identifier)?
(* A subquery in FROM or JOIN. It becomes a block named by its alias. *)
derived       := <"("> <ws?> select <ws?> <")"> as-alias

update        := <UPDATE> <ws> table-ref <ws> <SET> <ws> assignment (<ws?> <","> <ws?> assignment)* update-from? where?
assignment    := column <ws?> <"="> <ws?> value
update-from   := <ws> <FROM> <ws> (table-ref | derived) join*
delete        := <DELETE> <ws> <FROM> <ws> table-ref delete-using? where?
delete-using  := <ws> <USING> <ws> (table-ref | derived) join*

join          := <ws> join-type <JOIN> <ws> (table-ref | derived) <ws> (on | using)
join-type     := (<INNER> <ws>)? | left <ws> (<OUTER> <ws>)? | right <ws> (<OUTER> <ws>)?
left          := <LEFT>
right         := <RIGHT>
on            := <ON> <ws?> predicate
using         := <USING> <ws?> <"("> <ws?> identifier (<ws?> <","> <ws?> identifier)* <ws?> <")">

where         := <ws> <WHERE> <ws?> predicate

(* OR below AND below NOT below a comparison. A run of the same connective
   is one node, so `a and b and c` has three children, not a nested pair. *)
predicate     := or-expr
<or-expr>     := or | and-expr
or            := and-expr (<ws?> <OR> <ws?> and-expr)+
<and-expr>    := and | not-expr
and           := not-expr (<ws?> <AND> <ws?> not-expr)+
<not-expr>    := not | paren | comparison
not           := <NOT> <ws?> not-expr
<paren>       := <"("> <ws?> or-expr <ws?> <")">

<comparison>  := compare | like | is-null | is-distinct | in | in-select | between | truthy | call-truthy
(* A function or a count is compared too: in HAVING (`COUNT(1) > 1`), and
   so a function in WHERE is refused by name rather than at a parse error. *)
compare       := cmp-operand <ws?> cmp-op <ws?> cmp-operand
<cmp-operand> := concat | operand | call | count-star
(* A function that is true or false on its own: BOOL_OR(...) in HAVING. *)
call-truthy   := call
cmp-op        := "=" | "<>" | "!=" | ">=" | "<=" | ">" | "<"
like          := operand <ws> negated? like-op <ws> operand
like-op       := LIKE | ILIKE
is-null       := cmp-operand <ws> <IS> <ws> negated? <NULL>
is-distinct   := operand <ws> <IS> <ws> negated? <DISTINCT> <ws> <FROM> <ws> operand
in            := operand <ws> negated? <IN> <ws?> <"("> <ws?> operand (<ws?> <","> <ws?> operand)* <ws?> <")">
in-select     := operand <ws> negated? <IN> <ws?> <"("> <ws?> select <ws?> <")">
between       := operand <ws> negated? <BETWEEN> <ws> operand <ws> <AND> <ws> operand
(* `WHERE active`: a column on its own is a boolean test. *)
truthy        := column
negated       := <NOT> <ws>

operand       := (column | string | number | boolean | null | variable) cast? | cast-fn | now | special-value
cast          := <ws?> <"::"> <ws?> type-name
(* CAST(x AS t) is x::t, whatever x is. *)
cast-fn       := <CAST> <ws?> <"("> <ws?> value <ws> <AS> <ws> type-name <ws?> <")">
(* Read so they can be refused by name, not taken for column names. *)
special-value := CURRENT_DATE | CURRENT_TIME | LOCALTIME | CURRENT_USER | SESSION_USER
type-name     := #"(?i)[A-Za-z_][A-Za-z0-9_]*(?:\s+(?:with|without)\s+time\s+zone)?"

group         := <ws> <GROUP> <ws> <BY> <ws> column (<ws?> <","> <ws?> column)*
having        := <ws> <HAVING> <ws?> predicate
order         := <ws> <ORDER> <ws> <BY> <ws> order-item (<ws?> <","> <ws?> order-item)*
order-item    := (column | count-star | position | computed) (<ws> direction)?
position      := #"[0-9]+"
direction     := ASC | DESC
limit         := <ws> <LIMIT> <ws> #"[0-9]+"

column        := (identifier <ws?> <"."> <ws?>)? identifier

(* ---------------------------------------------------------------------
   Computed values: COALESCE(a, b), 'att:' || x, CASE WHEN ... END,
   (x IS NOT NULL), MIN(x) FILTER (WHERE ...), BOOL_OR(x = 'v'). Pine says
   these as computed values (docs/computed-values.md). A bare column or
   literal is never a computed value here, so each reads one way.
   --------------------------------------------------------------------- *)
computed      := concat | call | case | paren-value | now | special-value | cast-operand | select-condition
(* A literal or column with a cast: `a::text AS k`, `CAST(a AS text) AS k`. *)
cast-operand  := (column | string | number | boolean | null | variable) cast | cast-fn
(* A condition as a selected value, without parentheses: `x IS NULL AS k`. *)
<select-condition> := compare | like | is-null | is-distinct | in | in-select | between
<value>       := concat | value-term
concat        := value-term (<ws?> <"||"> <ws?> value-term)+
<value-term>  := call | case | paren-value | operand
(* A condition in parentheses is a value, true or false: (x IS NOT NULL). *)
paren-value   := <"("> <ws?> (strict-predicate | value) <ws?> <")"> cast?
(* A function call. A count and NOW() have rules of their own. *)
call          := fn-name <ws?> <"("> <ws?> (call-arg (<ws?> <","> <ws?> call-arg)*)? <ws?> <")"> filter? cast?
fn-name       := #"(?!(?i:select|from|where|join|inner|left|right|full|outer|cross|natural|on|using|and|or|not|in|is|null|like|ilike|between|group|order|by|limit|offset|fetch|having|union|intersect|except|distinct|all|as|asc|desc|true|false|case|when|then|else|end|exists|with|escape|similar|window|over|nulls|lateral|cast|returning|into|values|set|recursive|count|now|row_number|filter|having|when|then|else|end|partition|current_timestamp|current_date|current_time|localtimestamp|localtime|current_user|session_user)\b)[A-Za-z_][A-Za-z0-9_]*"
<call-arg>    := strict-predicate | value
filter        := <ws?> <FILTER> <ws?> <"("> <ws?> <WHERE> <ws> predicate <ws?> <")">
case          := <CASE> <ws> (when+ | case-subject simple-when+) (<ELSE> <ws> value <ws>)? <END>
when          := <WHEN> <ws> predicate <ws> <THEN> <ws> value <ws>
(* CASE x WHEN 1 THEN ... is CASE WHEN x = 1 THEN ... *)
case-subject  := value <ws>
simple-when   := <WHEN> <ws> value <ws> <THEN> <ws> value <ws>
(* A condition that isn't a column or a function on its own, so an argument
   like COALESCE(x, ...) reads as a value, not as `WHERE x`. *)
strict-predicate := or | and | not | compare | like | is-null | is-distinct | in | in-select | between
(* CURRENT_TIMESTAMP and LOCALTIMESTAMP are the time now, as NOW() is. *)
now           := <NOW> <ws?> <"("> <ws?> <")"> | <CURRENT_TIMESTAMP> | <LOCALTIMESTAMP>

<identifier>  := bare-identifier | quoted-identifier
bare-identifier   := #"(?!(?i:select|from|where|join|inner|left|right|full|outer|cross|natural|on|using|and|or|not|in|is|null|like|ilike|between|group|order|by|limit|offset|fetch|having|union|intersect|except|distinct|all|as|asc|desc|true|false|case|when|then|else|end|exists|with|escape|similar|window|over|nulls|lateral|cast|returning|into|values|set|recursive|current_timestamp|current_date|current_time|localtimestamp|localtime|current_user|session_user)\b)[A-Za-z_][A-Za-z0-9_]*"
(* "name" in Postgres, `name` in MySQL. "" inside "..." is one quote. *)
quoted-identifier := <"\""> #"(?:[^\"]|\"\")+" <"\""> | <"`"> #"[^`]+" <"`">

string        := <"'"> #"(?:[^']|'')*+" <"'">
number        := #"-?[0-9]+(?:\.[0-9]+)?"
boolean       := TRUE | FALSE
null          := <NULL>
variable      := <"$"> #"[A-Za-z_][A-Za-z0-9_]*"

(* Spaces and comments, one token, as in pine.bnf (see the note there). *)
ws            := #"(?s)(?:[ \t\r\n]++|--[^\r\n]*+|/\*.*?\*/)++"

SELECT  := #"(?i)select\b"
FROM    := #"(?i)from\b"
WHERE   := #"(?i)where\b"
JOIN    := #"(?i)join\b"
INNER   := #"(?i)inner\b"
LEFT    := #"(?i)left\b"
RIGHT   := #"(?i)right\b"
OUTER   := #"(?i)outer\b"
ON      := #"(?i)on\b"
USING   := #"(?i)using\b"
AND     := #"(?i)and\b"
OR      := #"(?i)or\b"
NOT     := #"(?i)not\b"
IN      := #"(?i)in\b"
IS      := #"(?i)is\b"
NULL    := #"(?i)null\b"
LIKE    := #"(?i)like\b"
ILIKE   := #"(?i)ilike\b"
BETWEEN := #"(?i)between\b"
GROUP   := #"(?i)group\b"
ORDER   := #"(?i)order\b"
BY      := #"(?i)by\b"
LIMIT   := #"(?i)limit\b"
AS      := #"(?i)as\b"
ASC     := #"(?i)asc\b"
DESC    := #"(?i)desc\b"
TRUE    := #"(?i)true\b"
FALSE   := #"(?i)false\b"
COUNT   := #"(?i)count\b"
CAST    := #"(?i)cast\b"
DISTINCT := #"(?i)distinct\b"
ROW_NUMBER := #"(?i)row_number\b"
OVER    := #"(?i)over\b"
PARTITION := #"(?i)partition\b"
UPDATE  := #"(?i)update\b"
SET     := #"(?i)set\b"
DELETE  := #"(?i)delete\b"
WITH    := #"(?i)with\b"
HAVING  := #"(?i)having\b"
FILTER  := #"(?i)filter\b"
CASE    := #"(?i)case\b"
WHEN    := #"(?i)when\b"
THEN    := #"(?i)then\b"
ELSE    := #"(?i)else\b"
END     := #"(?i)end\b"
NOW     := #"(?i)now\b"
CURRENT_TIMESTAMP := #"(?i)current_timestamp\b"
LOCALTIMESTAMP := #"(?i)localtimestamp\b"
CURRENT_DATE := #"(?i)current_date\b"
CURRENT_TIME := #"(?i)current_time\b"
LOCALTIME := #"(?i)localtime\b"
CURRENT_USER := #"(?i)current_user\b"
SESSION_USER := #"(?i)session_user\b"
